# Strapi env example (sanitized)

# Database
DATABASE_HOST=db
DATABASE_PORT=5432
DATABASE_NAME=dailynews_db
DATABASE_USERNAME=dailynews
DATABASE_PASSWORD=REPLACE_WITH_SECURE_PASSWORD

# Admin (use these to create the first admin or set via UI)
STRAPI_ADMIN_EMAIL=REPLACE_WITH_ADMIN_EMAIL
STRAPI_ADMIN_PASSWORD=REPLACE_WITH_ADMIN_PASSWORD

# Change APP_KEYS / SECRETS in production
APP_KEYS=replace_this_in_production
API_TOKEN_SALT=replace_this_in_production
ADMIN_JWT_SECRET=replace_this_in_production
JWT_SECRET=replace_this_in_production
